{
  "name": "my-fancy-task-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "cd frontend && vite",
    "server": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "db:reset:demo": "node --disable-warning=ExperimentalWarning server/reset.mjs --yes",
    "build": "cd frontend && tsc && vite build",
    "preview": "cd frontend && vite preview",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "cd frontend && storybook dev -p 6006",
    "build-storybook": "cd frontend && storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@storybook/react": "^7.6.17",
    "msw": "^2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "sonner": "^1.7.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/react-vite": "^7.6.17",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "storybook": "^7.6.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.4"
  }
}
